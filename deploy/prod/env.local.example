# Copy to env.local (gitignored) and fill in YOUR real values, then deploy as usual.
# Keeping these out of the committed tree lets the repo stay public while you deploy to
# your own environment. Sourced by deploy/scripts/deploy-harbor.sh.
export NCP_REGION=ca-central-1
export NCP_HARBOR_INSTANCE=i-0123456789abcdef0                 # the harbor EC2 instance id
export NCP_ARTIFACT_BUCKET=ncp-artifacts-123456789012          # artifacts S3 bucket (harbor pushes here)
export NCP_ARTIFACTS_BASE=https://ncp-artifacts-123456789012.s3.ca-central-1.amazonaws.com
export NCP_TFSTATE_BUCKET=ncp-tfstate-123456789012             # terraform state S3 bucket
export NCP_ACCOUNT_ID=123456789012

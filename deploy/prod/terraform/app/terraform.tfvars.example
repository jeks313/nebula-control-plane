# Copy to terraform.tfvars and fill in. This file holds ONLY non-secret config.
# NEVER put aws_access_key_id / aws_secret_access_key here — credentials come from
# the environment / aws-vault (see README.md). terraform.tfvars is gitignored.

region              = "ca-central-1"
allowed_ssh_cidr    = "203.0.113.10/32" # <- your public IP /32: curl -s https://checkip.amazonaws.com
ssh_public_key_path = "~/.ssh/absolute.pub"
instance_type       = "t3.micro"

# Pin + verify the nebula download (recommended). Get the value from the release page.
# nebula_sha256     = "<sha256 of nebula-linux-amd64.tar.gz for v1.10.3>"

# Enrollment gateway exposure. The off-cloud iMac enrolls over this, so it must
# reach your home IP. Default is open (the gateway is credential-less + rate-limited);
# tighten if you want.
# gateway_cidr      = "0.0.0.0/0"
# gateway_port      = 8443
# nebula_port       = 4242

# Enrollment-portal SSO (ADR 0004). Leave all empty to keep SSO disabled (setting sso_acs_url is the
# trigger). These make the SSO config durable so a fresh bootstrap reproduces it; the assertion + SP
# keypairs are genesis-generated (never set here). sso_idp_metadata_file is the SECOND (portal) SAML
# app's IdP federation-metadata XML on the machine running the bootstrap.
# sso_acs_url           = "https://poc-gateway.mesh.failsafe.net:8443/v1/sso/acs"
# sso_entity_id         = "https://poc-gateway.mesh.failsafe.net:8443/v1/sso/metadata"
# sso_issuer            = "https://sts.windows.net/<tenant-id>/"
# sso_groups_attr       = "http://schemas.microsoft.com/ws/2008/06/identity/claims/groups"
# sso_idp_metadata_file = "/path/to/portal-app-federation-metadata.xml"

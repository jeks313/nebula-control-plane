# SPIKE — Fargate lighthouse (lighthouse_runtime = "fargate"). A dedicated lighthouse
# does only control-plane work — discovery (overlay->underlay registration + queries)
# and NAT hole-punch coordination, all over UDP — and passes NO data-plane traffic to
# or from itself, so it can run `nebula` with `tun.disabled`: no TUN device, no
# CAP_NET_ADMIN, no privilege. That makes it Fargate-eligible (unlike Core, which
# routes core-api over the overlay and needs a real TUN). It is still a full Nebula
# PROTOCOL participant — it has a cert and speaks the (Noise-encrypted, cert-mutually-
# authenticated) lighthouse protocol — so this is "VM-free", NOT "off-mesh" the way the
# gateway is. Everything here is created ONLY when lighthouse_runtime = "fargate".
#
# Shared locals (local.lh_fargate, local.lighthouse_image) + the ECS assume-role policy
# live in fargate.tf.
#
# ⚠ KEY SPIKE UNKNOWN — client address observation behind the NLB. A lighthouse learns
# each host's POST-NAT underlay address from the *source* of the UDP packet it receives.
# So the UDP NLB MUST preserve the client address (preserve_client_ip = true below); if
# it rewrote the source to the NLB's, every host would register the NLB's address and
# hole-punching would fail. This is set but UNVERIFIED on a live apply — the one thing to
# confirm first. Stable address: the lighthouse's underlay is baked into every host's
# static_host_map, so the NLB carries an Elastic IP (Fargate task IPs are ephemeral).

resource "aws_ecr_repository" "lighthouse" {
  count                = local.lh_fargate
  name                 = "${var.name_prefix}-lighthouse"
  image_tag_mutability = "MUTABLE"
  force_delete         = true
  image_scanning_configuration {
    scan_on_push = true
  }
}

resource "aws_cloudwatch_log_group" "lighthouse" {
  count             = local.lh_fargate
  name              = "/${var.name_prefix}/lighthouse"
  retention_in_days = 14
}

# The lighthouse's nebula identity (CA + its genesis-issued cert + host key), created
# empty here and populated out-of-band by the genesis bootstrap. NB: unlike the EC2
# lighthouse (whose host key is generated on the box and never leaves), the Fargate
# key is generated by the bootstrap and injected — a deliberate spike trade-off.
resource "aws_secretsmanager_secret" "lighthouse" {
  count                   = local.lh_fargate
  name                    = "${var.name_prefix}-lighthouse-config"
  recovery_window_in_days = 0 # lab: allow immediate delete/recreate
}

resource "aws_secretsmanager_secret_version" "lighthouse" {
  count     = local.lh_fargate
  secret_id = aws_secretsmanager_secret.lighthouse[0].id
  secret_string = jsonencode({
    ca_crt_pem   = "" # the mesh CA cert
    host_crt_pem = "" # the lighthouse's genesis-issued cert
    host_key_pem = "" # its host key
  })
  lifecycle {
    ignore_changes = [secret_string] # the bootstrap owns the real values
  }
}

# ── IAM: task EXECUTION role (pull ECR image, write logs, read the config secret) ─
# (the assume-role policy is the shared data.aws_iam_policy_document.ecs_assume in fargate.tf)
resource "aws_iam_role" "lighthouse_exec" {
  count              = local.lh_fargate
  name_prefix        = "${var.name_prefix}-lh-exec-"
  assume_role_policy = data.aws_iam_policy_document.ecs_assume[0].json
}

resource "aws_iam_role_policy_attachment" "lighthouse_exec" {
  count      = local.lh_fargate
  role       = aws_iam_role.lighthouse_exec[0].name
  policy_arn = "arn:aws:iam::aws:policy/service-role/AmazonECSTaskExecutionRolePolicy"
}

resource "aws_iam_role_policy" "lighthouse_secret" {
  count = local.lh_fargate
  name  = "read-lighthouse-config"
  role  = aws_iam_role.lighthouse_exec[0].id
  policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Effect   = "Allow"
      Action   = ["secretsmanager:GetSecretValue"]
      Resource = [aws_secretsmanager_secret.lighthouse[0].arn]
    }]
  })
}

# ── Security groups ──────────────────────────────────────────────────────────
# The lighthouse's UDP discovery faces the internet (like the EC2 lighthouse). The
# stats port is internal — health-check only, never public.
resource "aws_security_group" "lighthouse_nlb" {
  count       = local.lh_fargate
  name_prefix = "${var.name_prefix}-lh-nlb-"
  description = "Fargate lighthouse NLB: public Nebula UDP discovery."
  vpc_id      = aws_vpc.main.id

  ingress {
    description = "Nebula overlay handshake / lighthouse discovery"
    from_port   = var.nebula_port
    to_port     = var.nebula_port
    protocol    = "udp"
    cidr_blocks = ["0.0.0.0/0"]
  }
  egress {
    # Forward discovery to the tasks (mesh subnet). Target the subnet CIDR, not the
    # task SG, so the NLB and task SGs don't reference each other (cycle).
    description = "Forward Nebula UDP to the lighthouse tasks (mesh subnet)"
    from_port   = var.nebula_port
    to_port     = var.nebula_port
    protocol    = "udp"
    cidr_blocks = [local.tier_cidr["mesh"]]
  }
  egress {
    description = "Health check the task stats port (mesh subnet)"
    from_port   = var.lighthouse_stats_port
    to_port     = var.lighthouse_stats_port
    protocol    = "tcp"
    cidr_blocks = [local.tier_cidr["mesh"]]
  }
  lifecycle {
    create_before_destroy = true
  }
}

resource "aws_security_group" "lighthouse_task" {
  count       = local.lh_fargate
  name_prefix = "${var.name_prefix}-lh-task-"
  description = "Fargate lighthouse task: public Nebula UDP (client IP preserved) + NLB health check; egress for mesh UDP + image/secret/DNS."
  vpc_id      = aws_vpc.main.id

  ingress {
    # With preserve_client_ip, discovery arrives with the CLIENT's source address, so
    # this must allow the public, not the NLB's SG.
    description = "Nebula UDP discovery (client IP preserved through the NLB)"
    from_port   = var.nebula_port
    to_port     = var.nebula_port
    protocol    = "udp"
    cidr_blocks = ["0.0.0.0/0"]
  }
  ingress {
    description     = "Stats health check from the NLB"
    from_port       = var.lighthouse_stats_port
    to_port         = var.lighthouse_stats_port
    protocol        = "tcp"
    security_groups = [aws_security_group.lighthouse_nlb[0].id]
  }
  # Mesh UDP out (nebula keepalives / punch coordination to hosts at arbitrary
  # addresses) + bootstrap (ECR/Secrets) + DNS. Mirrors the EC2 lighthouse SG.
  egress {
    description = "Nebula data plane + DNS (UDP)"
    from_port   = 0
    to_port     = 65535
    protocol    = "udp"
    cidr_blocks = ["0.0.0.0/0"]
  }
  egress {
    description = "ECR / Secrets Manager / package fetch (https/http)"
    from_port   = 443
    to_port     = 443
    protocol    = "tcp"
    cidr_blocks = ["0.0.0.0/0"]
  }
  egress {
    from_port   = 80
    to_port     = 80
    protocol    = "tcp"
    cidr_blocks = ["0.0.0.0/0"]
  }
  lifecycle {
    create_before_destroy = true
  }
}

# ── Network Load Balancer with a stable Elastic IP (static_host_map needs it) ───
resource "aws_eip" "lighthouse_nlb" {
  count  = local.lh_fargate
  domain = "vpc"
  tags   = { Name = "${var.name_prefix}-lighthouse-nlb" }
}

resource "aws_lb" "lighthouse" {
  count              = local.lh_fargate
  name_prefix        = "ncplh-"
  load_balancer_type = "network"
  internal           = false
  security_groups    = [aws_security_group.lighthouse_nlb[0].id]
  subnet_mapping {
    subnet_id     = aws_subnet.tier["mesh"].id
    allocation_id = aws_eip.lighthouse_nlb[0].id # pin the public IP for static_host_map
  }
  depends_on = [aws_internet_gateway.igw]
}

resource "aws_lb_target_group" "lighthouse" {
  count              = local.lh_fargate
  name_prefix        = "ncplh-"
  port               = var.nebula_port
  protocol           = "UDP"
  vpc_id             = aws_vpc.main.id
  target_type        = "ip"
  preserve_client_ip = true # CRITICAL: the lighthouse observes hosts' real underlay addresses

  # UDP target groups require a non-UDP health check; use nebula's prometheus stats
  # TCP port (the nebula-boot shim's rendered config enables it, internal only).
  health_check {
    protocol = "TCP"
    port     = tostring(var.lighthouse_stats_port)
  }
}

resource "aws_lb_listener" "lighthouse" {
  count             = local.lh_fargate
  load_balancer_arn = aws_lb.lighthouse[0].arn
  port              = var.nebula_port
  protocol          = "UDP"
  default_action {
    type             = "forward"
    target_group_arn = aws_lb_target_group.lighthouse[0].arn
  }
}

# ── ECS Fargate cluster / task / service ────────────────────────────────────────
resource "aws_ecs_cluster" "lighthouse" {
  count = local.lh_fargate
  name  = "${var.name_prefix}-lighthouse"
}

resource "aws_ecs_task_definition" "lighthouse" {
  count                    = local.lh_fargate
  family                   = "${var.name_prefix}-lighthouse"
  requires_compatibilities = ["FARGATE"]
  network_mode             = "awsvpc"
  cpu                      = var.lighthouse_fargate_cpu
  memory                   = var.lighthouse_fargate_memory
  execution_role_arn       = aws_iam_role.lighthouse_exec[0].arn

  container_definitions = jsonencode([{
    name      = "lighthouse"
    image     = local.lighthouse_image
    essential = true
    # tun.disabled => no TUN, no privilege; runs as the distroless nonroot user.
    user = "65532"
    portMappings = [
      { containerPort = var.nebula_port, protocol = "udp" },
      { containerPort = var.lighthouse_stats_port, protocol = "tcp" }, # health check only
    ]
    environment = [
      { name = "NCP_LH_NEBULA_PORT", value = tostring(var.nebula_port) },
      { name = "NCP_LH_STATS_PORT", value = tostring(var.lighthouse_stats_port) },
    ]
    # Injected from Secrets Manager; the cmd/nebula-boot shim reads each from its env var,
    # writes the cert files + renders config.yml, then exec's nebula (no shell entrypoint).
    secrets = [
      { name = "NCP_LH_CA_CRT_PEM", valueFrom = "${aws_secretsmanager_secret.lighthouse[0].arn}:ca_crt_pem::" },
      { name = "NCP_LH_HOST_CRT_PEM", valueFrom = "${aws_secretsmanager_secret.lighthouse[0].arn}:host_crt_pem::" },
      { name = "NCP_LH_HOST_KEY_PEM", valueFrom = "${aws_secretsmanager_secret.lighthouse[0].arn}:host_key_pem::" },
    ]
    logConfiguration = {
      logDriver = "awslogs"
      options = {
        "awslogs-group"         = aws_cloudwatch_log_group.lighthouse[0].name
        "awslogs-region"        = var.region
        "awslogs-stream-prefix" = "lighthouse"
      }
    }
  }])
}

resource "aws_ecs_service" "lighthouse" {
  count           = local.lh_fargate
  name            = "${var.name_prefix}-lighthouse"
  cluster         = aws_ecs_cluster.lighthouse[0].id
  task_definition = aws_ecs_task_definition.lighthouse[0].arn
  desired_count   = 1
  launch_type     = "FARGATE"

  network_configuration {
    subnets          = [aws_subnet.tier["mesh"].id]
    security_groups  = [aws_security_group.lighthouse_task[0].id]
    assign_public_ip = true # mesh subnet routes to the IGW; lets the task pull ECR/Secrets without a NAT
  }
  load_balancer {
    target_group_arn = aws_lb_target_group.lighthouse[0].arn
    container_name   = "lighthouse"
    container_port   = var.nebula_port
  }
  depends_on = [aws_lb_listener.lighthouse]
}

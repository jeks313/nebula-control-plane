// Grafana Alloy config (ADR 0007 Phase 7c) — runs on each EC2 node (harbor, monitoring, the EC2
// lighthouse), tails the systemd journal (core-api/admin-api/collect/nebula/docker/pilot run via
// `systemd-run --collect` / systemd) and pushes to Loki on the monitoring node. Alloy is the
// supported successor to promtail (Grafana moved promtail to LTS/deprecated in 2025).
//
// REFERENCE: deploy.sh renders the live copy per node — substituting LOKI_ENDPOINT with the stable
// in-VPC Loki host (the terraform `loki_host` output: the private DNS name when a mesh domain is set,
// else the monitoring node's private IP; http://<host>:3100/loki/api/v1/push over the VPC, SG-locked)
// and NCP_HOST_LABEL with that node's `host` label. A DNS host means a monitoring relaunch is picked
// up by re-resolution — no baked IP to go stale.

loki.relabel "journal" {
	forward_to = []

	// Promote useful journald fields to labels so you can filter by service in Grafana.
	rule {
		source_labels = ["__journal__systemd_unit"]
		target_label  = "unit"
	}
	rule {
		source_labels = ["__journal_priority_keyword"]
		target_label  = "level"
	}
}

loki.source.journal "harbor" {
	max_age       = "12h"
	path          = "/var/log/journal"
	relabel_rules = loki.relabel.journal.rules
	labels        = {
		job  = "systemd-journal",
		host = "NCP_HOST_LABEL",
	}
	forward_to = [loki.write.default.receiver]
}

loki.write "default" {
	endpoint {
		url = "http://LOKI_ENDPOINT:3100/loki/api/v1/push"
	}
}

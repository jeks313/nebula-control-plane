[Unit]
Description=Nebula Control Plane host agent (Pilot)
Documentation=https://github.com/jeks313/nebula-control-plane
# Pilot supervises nebula, which needs the network up to reach lighthouses/peers.
Wants=network-online.target
After=network-online.target
# Give up looping if it crash-loops hard (Pilot also backs off internally).
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=exec
User=nebula-pilot
Group=nebula-pilot

# Pilot is the supervisor; nebula is its child. systemd supervises Pilot.
ExecStart=/usr/local/bin/pilot supervise \
    -config /etc/nebula-control-plane/config.yml \
    -nebula /usr/local/bin/nebula
# SIGHUP -> Pilot hot-reloads nebula in place (firewall/lighthouse/PKI). M1.8.
ExecReload=/bin/kill -HUP $MAINPID

# Stop the whole tree (Pilot + nebula) cleanly, escalate if it lingers.
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=15
Restart=on-failure
RestartSec=2

# config.yml, host.key, host.crt, ca.crt live here; systemd creates it 0700,
# owned by the service user, and makes it writable despite ProtectSystem=strict.
ConfigurationDirectory=nebula-control-plane
ConfigurationDirectoryMode=0700

# --- Least privilege (M1.9): nebula needs CAP_NET_ADMIN for the TUN device and
# routes; nothing else. The capability is ambient so the nebula child inherits
# it, and the bounding set caps the whole tree at exactly that one capability.
AmbientCapabilities=CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_ADMIN
NoNewPrivileges=yes

# --- Filesystem isolation ---
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
RuntimeDirectory=nebula-control-plane
# TUN access without exposing the rest of /dev. Standard pseudo-devices
# (null/zero/random/urandom/tty) are auto-allowed under DevicePolicy=closed.
DevicePolicy=closed
DeviceAllow=/dev/net/tun rw

# --- Kernel / process hardening ---
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
# UDP overlay (INET/INET6), netlink for tun/route config, unix for local IPC.
RestrictAddressFamilies=AF_INET AF_INET6 AF_NETLINK AF_UNIX
UMask=0077

[Install]
WantedBy=multi-user.target
